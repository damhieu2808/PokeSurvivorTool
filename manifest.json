{
  "manifest_version": 3,
  "name": "PokeSurvivor Bot",
  "version": "1.2.0",
  "description": "Auto-play bot and coin-farming preset for pokesurvivor.com by damhieu2808 (F6 catalog, F7 tag, F8 on/off, F9 overlay).",
  "homepage_url": "https://github.com/damhieu2808/PokeSurvivorTool",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://pokesurvivor.com/*"],
      "js": ["data.js", "moves.js", "bot.js", "farmMoney.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
