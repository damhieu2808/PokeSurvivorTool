{
  "manifest_version": 3,
  "name": "PokeSurvivor Bot",
  "version": "3.0.3",
  "description": "Auto-play bot and coin-farming preset for pokesurvivor.com, pokesurvivor.doofcraft.com and pokelit.0d4y.cc by damhieu2808 (F6 catalog, F7 tag, F8 on/off, F9 overlay).",
  "homepage_url": "https://github.com/damhieu2808/PokeSurvivorTool",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "core/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://www.pokesurvivor.com/*",
        "https://pokesurvivor.doofcraft.com/*",
        "https://pokelit.0d4y.cc/*"
      ],
      "js": [
        "core/keepalive.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://www.pokesurvivor.com/*"
      ],
      "js": [
        "sites/default/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokelit.0d4y.cc/*"
      ],
      "js": [
        "sites/pokelit/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://www.pokesurvivor.com/*"
      ],
      "js": [
        "sites/default/site.js",
        "sites/default/pilot.js",
        "sites/default/data.js",
        "core/moves.js",
        "core/bot.js",
        "core/farmMoney.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokelit.0d4y.cc/*"
      ],
      "js": [
        "sites/pokelit/site.js",
        "sites/pokelit/pilot.js",
        "sites/pokelit/data.js",
        "sites/pokelit/shop.js",
        "core/bot.js",
        "core/farmMoney.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokesurvivor.doofcraft.com/*"
      ],
      "js": [
        "sites/doofcraft/site.js",
        "sites/doofcraft/data.js",
        "core/bot.js",
        "core/farmMoney.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
